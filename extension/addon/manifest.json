{
  "manifest_version": 2,
  "name": "Zana",
  "description": "'Quality of life' extension for websites that sell books.",
  "version": "0.1.2",
  "icons": {
    "64": "icons/icon.png"
  },
  "permissions": [
    "webRequest",
    "https://dukagjinibooks.com/api/products/*",
    "https://api.dukagjinibooks.com/api/*",
    "https://www.dukagjinibooks.com/api/products/*",
    "https://api.zanareads.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dukagjinibooks.com/*"
      ],
      "js": [
        "lib/browser-polyfill.min.js",
        "modules/zana.js",
        "modules/dukagjinibooks.js",
        "content_script.js"
      ],
      "css": [
        "css/zana.css"
      ]
    }
  ],
  "web_accessible_resources": [
    "images/powered_by_googlebooks.png",
    "images/powered_by_openlibrary.svg",
    "images/main/external_link.svg",
    "images/main/loading.gif",
    "css/zana.css"
  ]
}
